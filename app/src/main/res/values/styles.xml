<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MenuButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton" >
        <item name="android:textSize">@dimen/mediumTextSize</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/smallCornerRadius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">@dimen/smallIconSize</item>
        <item name="android:layout_marginHorizontal">@dimen/smallPadding</item>
        <item name="android:layout_marginVertical">@dimen/littlePadding</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/colorSecondaryVariant</item>
        <item name="iconTint">?attr/colorSecondaryVariant</item>
        <item name="android:backgroundTint">?attr/colorOnPrimary</item>
    </style>

    <style name="MenuMainStyle" >
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/mediumTextSize</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginHorizontal">@dimen/smallPadding</item>
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>

    <style name="Search">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLength">20</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColorHint">?attr/colorOnSecondary</item>
        <item name="android:textColor">@color/YP_Black</item>
        <item name="android:drawableTint">?attr/colorOnSecondary</item>
        <item name="android:background">@drawable/search_style</item>
    </style>

    <style name="SearchMusic">
        <item name="android:textColorHint">?attr/colorOnSecondary</item>
        <item name="android:drawableTint">?attr/colorOnSecondary</item>
        <item name="android:background">@drawable/search_style</item>
    </style>






    <style name="MusicViewTextL">
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="layout_constraintHorizontal_chainStyle">spread_inside</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_width">124dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="MusicViewTextR">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">?attr/colorPrimaryVariant</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:gravity">end</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
     </style>

    <style name="MusicViewMainTextT">
        <item name="android:textColor">?attr/colorPrimaryVariant</item>
        <item name="android:textSize">22sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="MusicViewMainTextB">
        <item name="android:textColor">?attr/colorPrimaryVariant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="MusicViewTimer">
        <item name="android:textColor">?attr/colorPrimaryVariant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="MusicViewButton">
        <item name="android:backgroundTint">?attr/colorOnSecondary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="layout_constraintDimensionRatio">1:1</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">25dp</item>
        <item name="iconTint">@null</item>
    </style>
    <style name="PlayerTrackPropertyTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/player_track_properties_margin</item>
        <item name="android:layout_marginLeft">@dimen/player_track_properties_margin</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="android:textColor">?attr/colorPrimaryVariant</item>
        <item name="android:textSize">@dimen/player_track_properties_textSize</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="PlayerTrackPropertyValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="android:layout_marginEnd">@dimen/player_track_properties_margin</item>
        <item name="android:textColor">?attr/colorPrimaryVariant</item>
        <item name="android:textSize">@dimen/player_track_properties_textSize</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">end</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>



    <style name="SearchErrorButton">
        <item name="android:layout_marginTop">@dimen/mediumPadding</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/colorPrimary</item>

        <item name="android:padding">6dp</item>
        <item name="android:backgroundTint">?attr/colorPrimaryVariant</item>
    </style>

    <style name="MediaLibrary">

    </style>

    <style name="MediaLibraryButtonBack">

    </style>

    <style name="MediaLibraryButtonBackText">

    </style>

    <style name="SearchErrorImage">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">120dp</item>
        <item name="android:src">@drawable/search_error_notfound</item>
        <item name="android:layout_gravity">center</item>
    </style>


</resources>