<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MLImageError">
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">46dp</item>
        <item name="layout_constraintBottom_toTopOf">@+id/buttonError</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintTop_toBottomOf">@+id/nameError</item>
    </style>

    <style name="MLNameError">
        <item name="android:maxLines">2</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginHorizontal">24dp</item>
        <item name="layout_constraintBottom_toTopOf">@+id/imageError</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="android:textAlignment">center</item>
        <item name="android:breakStrategy">balanced</item>
   </style>

    <style name="MLButtonError">
        <item name="android:layout_marginBottom">24dp</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintTop_toBottomOf">@+id/imageError</item>
        <item name="android:visibility">invisible</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:backgroundTint">?attr/colorPrimaryVariant</item>
    </style>




    <style name="SNameError">
        <item name="android:layout_gravity">center</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="SErrorImage">
        <item name="android:src">@drawable/search_error_notfound</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="SErrorButton">
        <item name="android:layout_marginTop">@dimen/mediumPadding</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:padding">6dp</item>
        <item name="android:backgroundTint">?attr/colorPrimaryVariant</item>
    </style>

    <style name="SCommentButton">
        <item name="android:layout_marginTop">@dimen/mediumPadding</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">19sp</item>
    </style>

</resources>