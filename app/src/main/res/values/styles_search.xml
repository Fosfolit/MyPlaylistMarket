<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SearchProgressBar">
        <item name="android:layout_gravity">center</item>
        <item name="android:indeterminateTint">@color/YP_Blue</item>
        <item name="android:visibility">gone</item>
        <item name="layout_constraintVertical_bias">0.25</item>
    </style>

    <style name="SearchInputText">
        <item name="android:layout_marginHorizontal">@dimen/littlePadding</item>
        <item name="android:padding">@dimen/littlePadding</item>
    </style>

    <style name="SearchInputTextEditText">
        <item name="android:paddingStart">@dimen/littlePadding</item>
        <item name="android:autofillHints">text</item>
        <item name="android:textCursorDrawable">@color/YP_Blue</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:inputType">text</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColorHint">?attr/colorOnSecondary</item>
        <item name="android:textColor">@color/YP_Black</item>
        <item name="android:drawableTint">?attr/colorOnSecondary</item>
        <item name="android:background">@drawable/search_style</item>
    </style>

    <style name="SearchInputTextClearIcon">
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:layout_marginEnd">@dimen/littlePadding</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="SearchToolbar">
    </style>

    <style name="SearchToolbarText">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/mediumTextSize</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:text">@string/search</item>
    </style>


</resources>