<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MLToolbar">
        <item name="itemIconTint">?attr/colorSecondary</item>
        <item name="navigationIconTint">?attr/colorSecondary</item>
    </style>

    <style name="MLToolbarText">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/mediumTextSize</item>
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>

    <style name="MLTabItem">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:textSize">@dimen/smallTextSize</item>
    </style>

    <style name="MLTabLayout">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="tabIndicatorColor">?attr/colorSecondary</item>
        <item name="tabIndicatorHeight">@dimen/megaShortPadding</item>
        <item name="tabPadding">@dimen/smallPadding</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabSelectedTextColor">?attr/colorSecondary</item>
    </style>
</resources>