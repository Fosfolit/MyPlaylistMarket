<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="100dp"
    android:layout_marginHorizontal="24dp"
    android:orientation="vertical"
    android:gravity="center"
    android:theme="@style/Search.Theme"
    android:backgroundTint="?attr/colorPrimary"
    >
    <ImageView
        android:id="@+id/imageError"
        android:layout_width="120dp"
        android:layout_height="120dp"
        style="@style/SErrorImage"
        />

    <TextView
        android:id="@+id/nameError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nothingFound"
        style="@style/SNameError"
        />

    <TextView
        android:id="@+id/commentError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text = "@string/loadErrorCheckInternet"
        style="@style/SCommentButton"
        />

    <Button
        android:id="@+id/buttonError"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/sErrorButton"
        android:text="@string/update"
        style="@style/SErrorButton"
        />
</LinearLayout>