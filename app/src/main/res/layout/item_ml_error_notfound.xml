<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:theme="@style/Media_library.Theme"
    android:backgroundTint="?attr/colorPrimary"
    >
    <Button
        android:id="@+id/buttonError"
        android:text="Новый пдейлист"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageError"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:textSize="14sp"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="?attr/colorPrimary"
        android:backgroundTint="?attr/colorPrimaryVariant"

    />
    <ImageView
        android:id="@+id/imageError"
        android:layout_width ="120dp"
        android:layout_height="120dp"
        android:src="@drawable/search_error_notfound"
        android:layout_gravity="center"
        android:layout_marginTop="46dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonError"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nameError"
        />

    <TextView
        android:id="@+id/nameError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:text="@string/mediaLibraryErrorEmptyMediaLibrary"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="?attr/colorSecondary"
        android:textSize="19sp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/imageError"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textAlignment="center"
        android:breakStrategy="balanced"
        />

</LinearLayout>