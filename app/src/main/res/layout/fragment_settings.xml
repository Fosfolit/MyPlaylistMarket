<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragment.SettingsFragment"
    android:theme="@style/Setting.Theme"
    android:background="?attr/colorPrimary"
    android:orientation="vertical"
    >

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/buttonBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/arrow_back"
        style="@style/SettingToolbar"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting"
            style="@style/SettingToolbarText"
            />

    </androidx.appcompat.widget.Toolbar>

    <Switch
        android:id="@+id/textViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/darkTheme"
        android:checked="false"
        style="@style/SettingMenuBlock"
        />

    <TextView
        android:id="@+id/textViewShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/shareApp"
        app:drawableEndCompat="@drawable/share"
        style="@style/SettingMenuBlock"
        />

    <TextView
        android:id="@+id/buttonHelper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/writeSupport"
        app:drawableEndCompat="@drawable/support"
        style="@style/SettingMenuBlock"
        />

    <TextView
        android:id="@+id/buttonUserText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/uerAgreement"
        app:drawableEndCompat="@drawable/vector"
        style="@style/SettingMenuBlock"
        />

</LinearLayout>