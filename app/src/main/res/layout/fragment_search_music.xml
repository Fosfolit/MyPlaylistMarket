<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/Search.Theme"
    android:background="?attr/colorPrimary"
    tools:context=".ui.fragment.SearchFragment">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/buttonBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/arrow_back"
            app:layout_constraintBottom_toTopOf="@+id/searchString"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SearchToolbar"
            >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search"
                    style="@style/SearchToolbarText"
                    />

        </androidx.appcompat.widget.Toolbar>

        <RelativeLayout
            android:id="@+id/searchString"
            android:layout_width="match_parent"
            android:layout_height="@dimen/searchBlockSearch"
            app:layout_constraintBottom_toTopOf="@+id/recyclerView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonBack"
            style="@style/SearchBlockSearch"
            >

                <EditText
                    android:id="@+id/inputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/search"
                    style="@style/SearchEditText"
                    />

                <ImageView
                    android:id="@+id/clearIcon"
                    android:layout_width="@dimen/smallTextSize"
                    android:layout_height="@dimen/smallTextSize"
                    android:src="@drawable/krest"
                    style="@style/SearchClearIcon"
                    />

        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/searchString"
            />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="@dimen/searchProgressBar"
            android:layout_height="@dimen/searchProgressBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/searchString"
            style="@style/SearchProgressBar"/>
</androidx.constraintlayout.widget.ConstraintLayout>



